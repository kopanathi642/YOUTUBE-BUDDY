# Copy to backend/.env for local development. Placeholders only — never commit real secrets.
ENV=development
DATABASE_URL=postgresql+psycopg://creator:creator@localhost:5432/creator
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=creator-media-dev
S3_ACCESS_KEY_ID=dev-access-key
S3_SECRET_ACCESS_KEY=dev-secret-key
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
COOKIE_SECURE=false
# Google sign-in (Firebase Authentication). Leave empty to hide the Google button.
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_API_KEY=
FIREBASE_APP_ID=

# --- AI Creation Universe providers (all optional; tools that need them show "Needs key" until set) ---
# AI_DAILY_BUDGET_USD=10   # max estimated paid-AI spend per workspace per day (0 = paid models off)
# AI_DAILY_PAID_RUNS=200   # max paid-AI runs per workspace per day
# FAL_KEY=            # fal.ai: Veo 3.1, Kling 3, Seedance, MiniMax, FLUX, Nano Banana, ElevenLabs music/SFX, lip-sync, 3D
# ANTHROPIC_API_KEY=  # Claude for writing, strategy and the Director Agent (or OPENAI_API_KEY)
# LLM_MODEL=claude-sonnet-5-5
# YOUTUBE_API_KEY=    # YouTube Data API v3 (public channel/trend data)

# --- Free stock library (both free; no card) ---
# PEXELS_API_KEY=     # https://www.pexels.com/api/
# PIXABAY_API_KEY=    # https://pixabay.com/api/docs/

# --- Plans & payments (UPI QR, manual approval — no gateway fees) ---
# ADMIN_EMAILS=you@gmail.com     # founder account(s) that can set the QR and approve payments (must sign in with Google in production)
# FREE_PLAN_PAID_RUNS=5          # premium AI runs per workspace per day on the Free plan

# --- YouTube publishing (free Google Cloud OAuth client, YouTube Data API v3) ---
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# PUBLIC_BASE_URL=https://your-domain   # redirect URI = PUBLIC_BASE_URL/api/v1/youtube/callback
# TOKEN_ENCRYPTION_KEY=          # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
