# Copy to backend/.env for local development. Placeholders only — never commit real secrets.
ENV=development
DATABASE_URL=postgresql+psycopg://creator:creator@localhost:5432/creator
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=creator-media-dev
S3_ACCESS_KEY_ID=dev-access-key
S3_SECRET_ACCESS_KEY=dev-secret-key
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
COOKIE_SECURE=false
# Google sign-in (Firebase Authentication). Leave empty to hide the Google button.
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_API_KEY=
FIREBASE_APP_ID=

# --- AI Creation Universe providers (all optional; tools that need them show "Needs key" until set) ---
# FAL_KEY=            # fal.ai: Veo 3.1, Kling 3, Seedance, MiniMax, FLUX, Nano Banana, ElevenLabs music/SFX, lip-sync, 3D
# ANTHROPIC_API_KEY=  # Claude for writing, strategy and the Director Agent (or OPENAI_API_KEY)
# LLM_MODEL=claude-sonnet-5-5
# YOUTUBE_API_KEY=    # YouTube Data API v3 (public channel/trend data)
